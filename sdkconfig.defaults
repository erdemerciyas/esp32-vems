# Waveshare ESP32-S3-Touch-LCD-2.1 (16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Konsol: USB-Serial-JTAG, kartin "USB" Type-C portu (GPIO19/20). UART0 konsolu kapali:
# GPIO43/44 K-Line (UART1) icin kullanilir.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Waveshare 2.1" ekran (CONFIG_VEMS_UI_ENABLE).
# Bounce buffer modunda her VSYNC'te DMA restart goruntuyu kaydirir; surucu sadece
# eksik veri tespit edince restart etsin. LCD/GDMA kesmeleri IRAM'de (PSRAM cache gecikmesi yok).
# CONFIG_LCD_RGB_RESTART_IN_VSYNC is not set
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# LVGL 8.2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_METER=y
CONFIG_LV_THEME_DEFAULT_DARK=y

# PSRAM framebuffer icin buyuk veri onbellegi, LVGL hizli fonksiyonlari IRAM'de
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
# LVGL ekran yenileme VSYNC'e kilitli (flush frame degisimini bekler), zamanlayici daha sik calisir
CONFIG_LV_DISP_DEF_REFR_PERIOD=10

